# Copy to .env and fill in your values. Read by make (deploy, infra-*, trader-check).
# Everything specific to one person's setup lives here, never in the repo.

# GCP project and region for Cloud Run, Artifact Registry and the buckets
GCP_PROJECT=your-gcp-project-id
GCP_REGION=asia-northeast1
CLOUD_RUN_SERVICE=dongpa-viewer
DONGPA_RATE_LIMIT=12

# Who may sign in through IAP (comma separated: user:you@example.com,user:friend@example.com)
IAP_MEMBERS=user:you@example.com
# Custom domain for the viewer; leave empty for the run.app URL only
VIEWER_DOMAIN=

# Optional overrides (defaults shown)
# PULUMI_STATE=gs://<GCP_PROJECT>-pulumi
# PULUMI_STACK=prod
# TRADER_BUCKET=<GCP_PROJECT>-dongpa-trader
# Where `python -m trader` writes run records; the deployed viewer reads the same place
# DONGPA_TRADER_RUNS=gs://<TRADER_BUCKET>/runs

# Broker keys for auto trading, named <BROKER>_<ACCOUNT ID>_* after config/trader/<id>.json
# (each brokerage account has its own app key). An account id that is not a valid variable
# name (Korean, dashes) sets "credentials_env" in its trader file, e.g. "MERITZ_SUB2".
# `make trader-secrets` copies every *_APP_KEY / *_APP_SECRET here into Secret Manager for the Cloud Run jobs.
# Meritz Securities: app key and secret from https://openapi.imeritz.com
MERITZ_MAIN_APP_KEY=
MERITZ_MAIN_APP_SECRET=
# MERITZ_SUB_APP_KEY=
# MERITZ_SUB_APP_SECRET=

# Daily bars: the dongpa-trader-data job (python -m trader data --push) refreshes data/ with the
# broker's previous closes and commits it here; the trader jobs read data/ from this repo's main branch.
# GITHUB_DATA_TOKEN: fine-grained PAT, this repo only, permission Contents read and write.
DONGPA_DATA_REPO=owner/backtest-dss
GITHUB_DATA_TOKEN=
# Account whose broker quotes the closes (config/trader/<id>.json), default main
# DONGPA_DATA_ACCOUNT=main
